%import common.NEWLINE

?start: file_start
file_start: default_language (superdiv | div)+
default_language: "<S=." LANG
superdiv: "\n" div_start (superdiv | div)+ "\n" DIV_CLOSE
div: "\n" div_start ["\n"] TEXTBLOCK_OPEN item+ "\n" TEXTBLOCK_CLOSE ["\n"] DIV_CLOSE
div_start: "<D=." (NAME_OR_NUMBER | RECTO | VERSO) ["." SUBTYPE] [".#" CORRESP]

_LINE_START: NEWLINE | "\ue747"
_leiden_lines: _leiden_line+
_leiden_line: [_LINE_START] (items
            | default_language
            | div_start [TEXTBLOCK_OPEN]
            | [TEXTBLOCK_CLOSE] DIV_CLOSE
            | TEXTBLOCK_OPEN
            | TEXTBLOCK_CLOSE
            | paragraphos
            | horizontal_rule
            | wavy_line
            | diple_obelismene
            | coronis)

// TEXT DIVISON
DIV_OPEN: "<D="
DIV_CLOSE: "=D>"
CORRESP: NAME_OR_NUMBER
TEXTBLOCK_OPEN: "<="
TEXTBLOCK_CLOSE: "=>"
RECTO: "r"
VERSO: "v"
SUBTYPE: "fragment" | "part" | "column" | "folio" | "side"

// QUANTIFIERS AND UNITS
CIRCA: "ca."
QUANTITY: /[0-9]+/
NUMBER: /[0-9]+/
LINE_NUMBER: /[0-9a-z]+/
range: NUMBER "-" NUMBER
LIN: "lin" | "lines"
CHAR: "char"
LIN_FORMAT: "perpendicular" | "inverse" | "indent" | "outdent"
LIN_MARGIN: ",ms" | ",md" | ",msup" | ",minf"
DOT: "."
LB: "-"
OR: " or "

// TEXT \u1f00-\u1fb0\u1fb2-\u1fb8\u1fba-\u1fd0\u1fd2-\u1fd8\u1fda-\u1fe0\u1fe2-\u1fe8\u1fea-\u1ffe
TEXT: /[’͵;,·˙𐅵𐅷𐅸ϙϡ\u037e-\u03ce\u03da-\u03e4\u1f00-\u1fb0\u1fb2-\u1fb8\u1fba-\u1fd0\u1fd2-\u1fd8\u1fda-\u1fe0\u1fe2-\u1fe8\u1fea-\u1ffe\u0300-\u0301\u0313-\u0314\u0340-\u0345]+(?![\u0323\u0304])/
GREEK_CHAR: /[𐅵𐅷𐅸ϙϡϛϚα-ωΑ-ΩΌΏΎΊΉᾲᾀᾁᾂᾃᾅᾇέάΐήώίόύϝϋϊᾄᾆᾳᾴᾷαβγδεζηθικλμνξοπρστυφχψωἀἄἂἆἁἅἃἇάὰᾶἐἔἒἑἕἓὲέἠἤἢἦἡἥἣἧὴήᾐᾑᾒᾓᾔᾕᾖᾗῂῃῄῆῇἰἴἲἶἱἵἳἷὶίῐῑῒΐῖῗὀὄὂὁὅὃὸόὐὑὒὓὔὕὖὗὺῦύῠῡῢΰῧὠὤὢὦὡὥὣὧώὼᾠᾡᾢᾣᾤᾥᾦᾧῲῳῴῶῷῤῥἈἌἊἎἉἍἋἏᾺΆᾼᾈᾉᾊᾋᾌᾍᾎᾏἘἜἚἙἝἛῈΈἨἬἪἮἩἭἫἯῊΉῌᾘᾙᾚᾛᾜᾝᾞᾟἸἼἺἾἹἽἻἿΊῚῘῙὈὌὊὉὍὋΌῸὙὝὛὟΎῪῨῩὨὬὪὮὩὭὫὯΏῺῼᾨᾩᾪᾫᾬᾭᾮᾯῬς]/
NON_DEF_TEXT: /.[^|]+/
NOTE_TEXT: /.[^*]+/
NAME: /[a-zA-Z]+/
RESP: /[ \-.:,()\p{L}0-9]+/
RESP_NO_COLON: /[ \-.,()\p{L}0-9]+/
NAME_HYPHEN: /[a-zA-Z\-]+/
NAME_OR_NUMBER: /[a-zA-Z0-9+]+/
FRACTION: /[0-9]+\/[0-9]+/
SPACE: " "

// SPECIAL CHARACTERS
REND_TICK: " '"
CERTAINTY_MATCH: "(?)"
EXTENT_UNKNOWN: "?"
CERT_LOW: "?" | "(?)"
SLASHES: "/ "
CROSS_STROKES: "X "
LANG: "grc" | "ar" | "cop" | "egy-Egyd" | "la" | "grc-Latn" | "la-Grek" | "cop-Grek"
REND: "extension" | "diple"
SUPRA_ALPHA_SMALL: "ᾱ"
SUPRA_ALPHA_CAPITAL: "Ᾱ"
SUPRA_IOTA_SMALL: "ῑ"
SUPRA_IOTA_CAPITAL: "Ῑ"
SUPRA_YPSILON_SMALL: "ῡ"
SUPRA_YPSILON_CAPITAL: "Ῡ"
?supra_escape: SUPRA_ALPHA_SMALL | SUPRA_ALPHA_CAPITAL | SUPRA_IOTA_SMALL | SUPRA_IOTA_CAPITAL | SUPRA_YPSILON_SMALL | SUPRA_YPSILON_CAPITAL
QMARK: /"/
UNDERDOT: "\u0323"

// DIACRITICALS
DIARESIS: "¨" | "&D"
ASPER: " ῾" | "&AS"
ACUTE: "´" | "&AC"
CIRCUMFLEX: "^" | "&C"
LENIS: " ᾿" | "&L"
GRAVE: "`" | "&G"

items: item+
?item: line
    | line_double
    | line_formatted
    | line_margin
    | line_rend
    | vacat
    | add_above
    | add_below
    | add_left
    | add_right
    | add_interlin
    | add_sling
    | add_underline
    | box
    | tall
    | superscripted
    | subscripted
    | supraline
    | underline
    | supraline_underline
    | supralinear_stroke
    | lines_lost
    | illegible
    | vestiges
    | ancient_number
    | ancient_number_no_text
    | omitted
    | surplus
    | deletion
    | deletion_corr
    | abbreviation
    | gap_lost
    | supplied_lost
    | parallel
    | parallel_lost
    | unclear
    | default_language
    | non_default_language
    | omitted_language
    | expansion
    | app_ed
    | app_ed_multi
    | app_reg
    | app_reg_multi
    | app_corr
    | app_subst
    | app_alt
    | app_alt_multi
    | symbol
    | drawing
    | handshift
    | note
    | quotation
    | diacritical_element
    | paragraphos
    | horizontal_rule
    | wavy_line
    | diple_obelismene
    | coronis
    | text_full_stop
    | text_space
    | text
    | lines_untranscribed
    | characters_untranscribed

?ex_or_text: ex | TEXT | illegible | supplied_lost | gap_lost | unclear | line | line_margin | line_rend | line_formatted | omitted | surplus

// PRESERVATION (VACAT, VESTIGES
vacat: "vac." [CIRCA] (range | QUANTITY | EXTENT_UNKNOWN) [LIN]
lines_lost: "lost." [CIRCA] (range | QUANTITY | EXTENT_UNKNOWN) LIN [CERTAINTY_MATCH]
illegible: (CIRCA | DOT) (range | QUANTITY | EXTENT_UNKNOWN) [LIN]
vestiges: "vestig." [CIRCA] (range | QUANTITY | EXTENT_UNKNOWN) [LIN]

// LINE
line: _LINE_START LINE_NUMBER "." [LB] " "
line_double: _LINE_START LINE_NUMBER "/" LINE_NUMBER "." [LB] " "
line_break_app: LINE_NUMBER ".- "
line_margin: _LINE_START LINE_NUMBER LIN_MARGIN "." [LB] " "
line_rend: _LINE_START "(" LINE_NUMBER ["." LB] ", " LIN_FORMAT ") "
line_formatted: _LINE_START LINE_NUMBER LIN_MARGIN ["." LB] ", " LIN_FORMAT ") "

// ADD
add_above: "\\" items [CERT_LOW] "/"
add_below: "//" items [CERT_LOW] "\\\\"
add_left: "||left:" items [CERT_LOW] "||"
add_right: "||right:" items [CERT_LOW] "||"
add_interlin: "||interlin:" items [CERT_LOW] "||"
add_sling: "<|" items [CERT_LOW] "|>"
add_underline: "<_" items [CERT_LOW] "_>"

// SPECIAL TEXT FORMAT
tall: "~||" items "||~tall"
superscripted: "|^" items "^|"
subscripted: "\\|" items "|/"
supralinear_stroke: (GREEK_CHAR [UNDERDOT] "\u0304" | supra_escape [UNDERDOT])+
supraline: "¯" items "¯"
underline: "_" items "_"
supraline_underline: "¯_" items "_¯"

// NUMBERS, SYMBOLS AND SPECIAL CHARACTERS
ancient_number: "<#" items [REND_TICK] "=" [NUMBER | FRACTION | NUMBER SPACE FRACTION] "#>"
ancient_number_no_text: "<#=" (NUMBER | FRACTION | NUMBER SPACE FRACTION) "#>"
symbol: "*" NAME_HYPHEN ["(" REND ")"] [CERT_LOW] "*"
drawing: "#" NAME_HYPHEN " "
box: "###"
paragraphos: _LINE_START "----"
horizontal_rule: _LINE_START "--------"
wavy_line: _LINE_START "~~~~~~~~"
diple_obelismene: _LINE_START ">---"
coronis: _LINE_START "-$$-"

// LEIDEN CONVENTIONS
omitted: "<" items [CERT_LOW] ">"
surplus: "{" items [CERTAINTY_MATCH] "}"
deletion: "〚" [SLASHES | CROSS_STROKES] items "〛"
deletion_corr: "[[" items "]]"
abbreviation: "(|" items [CERTAINTY_MATCH] "|)"
supplied_lost: "[" items [CERT_LOW] "]"
gap_lost: "[" (CIRCA | DOT) (range | QUANTITY | EXTENT_UNKNOWN) "]" [OR gap_lost]
parallel: "|_" items [CERT_LOW] "_|"
parallel_lost: "_[" items [CERT_LOW] "]_"
?unclear_char: GREEK_CHAR "\u0323"
unclear: unclear_char+
handshift: "$" NAME_OR_NUMBER [CERT_LOW] " "
note: "/*" NOTE_TEXT "*/"
quotation: QMARK items QMARK
diacritical: DIARESIS | ASPER | ACUTE | CIRCUMFLEX | LENIS | GRAVE
diacritical_element: " " (GREEK_CHAR | supplied_lost | gap_lost | illegible | unclear) "(" diacritical+ ")"
ex: "(" items [CERT_LOW] ")"
expansion: "(" ex_or_text+ ")"

// APPARATUS: must be improved for the transformer; careful: sometimes CERT_LOW, ocasionally CERTAINTY_MATCH
?app_item: item | line_break_app
?app_items: app_item+
lem: app_items [CERTAINTY_MATCH] ["=" RESP]
rdg: app_items [CERTAINTY_MATCH] ["=" RESP_NO_COLON]
app_ed: "<:" lem "|ed|" [rdg] ":>"
app_ed_multi: "<:" lem "||ed||" rdg ("|" rdg)+ ":>"

app_element_cl: app_items [CERT_LOW]
app_element_cm: app_items [CERTAINTY_MATCH]

reg: app_items [CERT_LOW] ["=" LANG]
app_reg: "<:" reg "|reg|" app_element_cm ":>"
app_reg_multi: "<:" reg ("|" reg)+ "||reg||" app_element_cm ":>"

app_corr: "<:" app_element_cl "|corr|" app_element_cm ":>"

app_subst: "<:" app_element_cm "|subst|" app_element_cm ":>"

app_alt: "<:" lem "|alt|" rdg ":>"
app_alt_multi: "<:" lem "||alt||" rdg ("|" rdg)+ ":>"

// LANGUAGE
non_default_language: "~|" NON_DEF_TEXT "|~" LANG " "
omitted_language: "(Lang: " NAME " " [CIRCA] (QUANTITY | range | EXTENT_UNKNOWN) " " (LIN | CHAR) ")"

// UNTRANSCRIBED
lines_untranscribed: "(Lines: " [CIRCA] (QUANTITY | range | EXTENT_UNKNOWN) " non transcribed)"
characters_untranscribed: "(Chars: " [CIRCA] (QUANTITY | range | EXTENT_UNKNOWN) " non transcribed)"

// TEXT
text_full_stop: DOT
text_space: SPACE
text: TEXT