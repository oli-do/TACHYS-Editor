?start: file_start
file_start: default_language (superdiv | div)+
default_language: "<S=." LANG
superdiv: NEWLINE div_start (superdiv | div)+ NEWLINE DIV_CLOSE
div: NEWLINE div_start [NEWLINE] TEXTBLOCK_OPEN item+ NEWLINE TEXTBLOCK_CLOSE [NEWLINE] DIV_CLOSE
div_start: DIV_OPEN "." (NAME_OR_NUMBER | RECTO | VERSO) ["." SUBTYPE] [".#" CORRESP]

// TEXT DIVISON
DIV_OPEN: "<D="
DIV_CLOSE: "=D>"
CORRESP: NAME_OR_NUMBER
TEXTBLOCK_OPEN: "<="
TEXTBLOCK_CLOSE: "=>"
RECTO: "r"
VERSO: "v"
SUBTYPE: "fragment" | "part" | "column" | "folio" | "side"

// QUANTIFIERS AND UNITS
CIRCA: "ca."
NUMBER: /[0-9]+/
RANGE: /[0-9]+-[0-9]+/
LIN: "lin" | "lines"
CHAR: "char"
LIN_FORMAT: "perpendicular" | "inverse" | "indent" | "outdent"
LIN_MARGIN: "ms" | "md" | "msup" | "minf"
DOT: "."
LB: "-"
OR: " or "

// TEXT
TEXT: /[’͵;,·˙\u037e-\u03ce\u03da-\u03e4\u1f00-\u1ffe\u0300-\u0301\u0313-\u0314\u0340-\u0345]+/
NON_DEF_TEXT: "~|" /[^|]*/ "|~"
NOTE: "/*" /(.|\n)*?/ "*/"
NAME: /[a-zA-Z]+/
RESP: /=[ \-.:,()a-zA-Z0-9]+/
RESP_NO_COLON: /=[ \-.,()a-zA-Z0-9]+/
NAME_HYPHEN: /[a-zA-Z\-]+/
NAME_OR_NUMBER: /[a-zA-Z0-9+]+/
FRACTION: /[0-9]+\/[0-9]+/
SPACE: " "
NEWLINE: "\n"

// SPECIAL CHARACTERS
TICK: "'"
UNDERDOT_CHAR: TEXT "\u0323"
SUPRALINE_CHAR: TEXT "\u0304"
UNCERTAIN: "(?)"
UNKNOWN: "?"
SLAHES: "/"
CROSS_STROKES: "X"
LANG: "grc" | "ar" | "cop" | "egy-Egyd" | "la" | "grc-Latn" | "la-Grek"
APP_MODE: "reg" | "alt" | "subst" | "corr" | "ed"
REND: "extension" | "diple"

// START-END
NUM_START: "<#"
NUM_END: "#>"
OMITTED_START: "<"
OMITTED_END: ">"
APP_START: "<:"
APP_END: ":>"
LINES_UNTRANSCRIBED_START: "(Lines:"
CHARS_UNTRANSCRIBED_START: "(Chars:"
NON_TRANSCRIBED: "non transcribed"

// DIACRITICALS
DIARESIS: "¨" | "&D"
ASPER: " ῾" | "&AS"
ACUTE: "´" | "&AC"
CIRCUMFLEX: "^" | "&C"
LENIS: " ᾿" | "&L"
GRAVE: "`" | "&G"

?item: line
    | line_formatted
    | line_margin
    | vacat
    | add_above
    | add_below
    | add_left
    | add_right
    | add_interlin
    | add_sling
    | add_underline
    | box
    | tall
    | superscripted
    | subscripted
    | supraline
    | supraline_underline
    | supralinear_stroke
    | lines_lost
    | illegible
    | vestiges
    | ancient_number
    | omitted
    | surplus
    | deletion
    | abbreviation
    | gap_lost
    | supplied_lost
    | parallel
    | parallel_lost
    | unclear
    | default_language
    | non_default_language
    | omitted_language
    | ex
    | expansion
    | apparatus
    | symbol
    | drawing
    | apparatus_multiple_front
    | apparatus_multiple_back
    | handshift
    | note
    | quotation
    | diacritical_element
    | paragraphos
    | horizontal_rule
    | wavy_line
    | diple_obelismene
    | coronis
    | text_full_stop
    | text_space
    | text
    | lines_untranscribed
    | characters_untranscribed

?ex_or_text: ex | text | UNCERTAIN

?number_content: SUPRALINE_CHAR | TEXT | TICK | SPACE | unclear | illegible | "[" text [UNCERTAIN] "]" | "[." NUMBER  "]"

// PRESERVATION (VACAT, VESTIGES
vacat: "vac." [CIRCA] (RANGE | NUMBER | UNKNOWN) [LIN]
lines_lost: "lost." [CIRCA] (RANGE | NUMBER | UNKNOWN) LIN [UNCERTAIN]
illegible: (CIRCA | DOT) (RANGE | NUMBER | UNKNOWN) [LIN]
vestiges: "vestig" [DOT] [CIRCA] (RANGE | NUMBER | UNKNOWN)? (LIN | CHAR)?

// LINE
line: NEWLINE NUMBER "." [LB] SPACE
line_margin: NEWLINE NUMBER "," LIN_MARGIN "." SPACE
line_formatted: NEWLINE "(" (NUMBER (DOT LB)? | NUMBER "," LIN_MARGIN) "," SPACE LIN_FORMAT ")" SPACE

// ADD
add_above: "\\" item+ [UNKNOWN] "/"
add_below: "//" item+ "\\\\"
add_left: "||left:" item+ "||"
add_right: "||right:" item+ "||"
add_interlin: "||interlin:" item+ "||"
add_sling: "<|" item+ "|>"
add_underline: "<_" item+ "_>"

// SPECIAL TEXT FORMAT
tall: "~||" item+ "||~tall"
superscripted: "|^" item+ "^|"
subscripted: "\\|" item+ "|/"
supralinear_stroke: SUPRALINE_CHAR+
supraline: "¯" item+ "¯"
supraline_underline: "¯_" item+ "_¯"

// NUMBERS, SYMBOLS AND SPECIAL CHARACTERS
ancient_number: NUM_START (number_content)* "=" [NUMBER | FRACTION] NUM_END
symbol: "*" NAME_HYPHEN ("(" REND ")")? [UNKNOWN] "*"
drawing: "#" NAME_HYPHEN SPACE
box: "###"
paragraphos: NEWLINE "----"
horizontal_rule: NEWLINE "--------"
wavy_line: NEWLINE "~~~~~~~~"
diple_obelismene: NEWLINE ">---"
coronis: NEWLINE "-$$-"

// LEIDEN CONVENTIONS
omitted: OMITTED_START item+ [UNCERTAIN] OMITTED_END
surplus: "{" item+ "}"
deletion: "〚" (SLAHES | CROSS_STROKES)? item+ "〛"
abbreviation: "(|" item+ [UNCERTAIN] "|)"
supplied_lost: "[" item+ [UNCERTAIN] "]"
gap_lost: "[" (CIRCA | DOT) (RANGE | NUMBER | UNKNOWN) "]" (OR gap_lost)*
parallel: "|_" item+ [UNCERTAIN] "_|"
parallel_lost: "_[" item+ "]_"
unclear: UNDERDOT_CHAR+
handshift: "$" NAME_OR_NUMBER [UNCERTAIN]
note: NOTE
quotation: /"/ item+ /"/
diacritical: DIARESIS | ASPER | ACUTE | CIRCUMFLEX | LENIS | GRAVE
diacritical_element: SPACE (text | supplied_lost | gap_lost | illegible) "(" diacritical+ ")"
ex: "(" text [SPACE] [UNKNOWN] ")"
expansion: "(" ex_or_text+ ")"

// APPARATUS
apparatus: APP_START item+ [UNCERTAIN] [RESP]"|" APP_MODE "|" (item+ [UNCERTAIN] [RESP_NO_COLON])? APP_END
apparatus_multiple_back: APP_START item+ [UNCERTAIN] [RESP] "||" APP_MODE "||" item+ ("|" item+ [UNCERTAIN] [RESP_NO_COLON])+ APP_END
apparatus_multiple_front: APP_START item+ [UNCERTAIN] [RESP] ("|" item+ [UNCERTAIN] [RESP])+ "||" APP_MODE "||" item+ [UNCERTAIN] [RESP_NO_COLON] APP_END

// LANGUAGE
non_default_language: NON_DEF_TEXT LANG
omitted_language: "(Lang:" SPACE NAME SPACE [CIRCA] (NUMBER | RANGE | UNKNOWN) SPACE (LIN | CHAR) ")"

// UNTRANSCRIBED
lines_untranscribed: LINES_UNTRANSCRIBED_START SPACE [CIRCA] (NUMBER | RANGE | UNKNOWN) SPACE NON_TRANSCRIBED ")"
characters_untranscribed: CHARS_UNTRANSCRIBED_START SPACE [CIRCA] (NUMBER | RANGE | UNKNOWN) SPACE NON_TRANSCRIBED ")"

// TEXT
text_full_stop: DOT
text_space: SPACE
text: TEXT