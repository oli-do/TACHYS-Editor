?start: file_start
file_start: default_language (superdiv | div)+
default_language: "<S=." LANG
superdiv: NEWLINE div_start (superdiv | div)+ NEWLINE DIV_CLOSE
div: NEWLINE div_start [NEWLINE] TEXTBLOCK_OPEN item+ NEWLINE TEXTBLOCK_CLOSE [NEWLINE] DIV_CLOSE
div_start: "<D=." (NAME_OR_NUMBER | RECTO | VERSO) ["." SUBTYPE] [".#" CORRESP]

// TEXT DIVISON
DIV_OPEN: "<D="
DIV_CLOSE: "=D>"
CORRESP: NAME_OR_NUMBER
TEXTBLOCK_OPEN: "<="
TEXTBLOCK_CLOSE: "=>"
RECTO: "r"
VERSO: "v"
SUBTYPE: "fragment" | "part" | "column" | "folio" | "side"

// QUANTIFIERS AND UNITS
CIRCA: "ca."
QUANTITY: /[0-9]+/
NUMBER: /[0-9]+/
range: NUMBER "-" NUMBER
LIN: "lin" | "lines"
CHAR: "char"
LIN_FORMAT: "perpendicular" | "inverse" | "indent" | "outdent"
LIN_MARGIN: ",ms" | ",md" | ",msup" | ",minf"
DOT: "."
LB: "-"
OR: " or "

// TEXT \u1f00-\u1fb0\u1fb2-\u1fb8\u1fba-\u1fd0\u1fd2-\u1fd8\u1fda-\u1fe0\u1fe2-\u1fe8\u1fea-\u1ffe
TEXT: /[’͵;,·˙\u037e-\u03ce\u03da-\u03e4\u1f00-\u1fb0\u1fb2-\u1fb8\u1fba-\u1fd0\u1fd2-\u1fd8\u1fda-\u1fe0\u1fe2-\u1fe8\u1fea-\u1ffe\u0300-\u0301\u0313-\u0314\u0340-\u0345]+(?![\u0323\u0304])/
GREEK_CHAR: /[α-ωΑ-ΩΌΏΎΊΉᾲᾀᾁᾂᾃᾅᾇέάΐήώίόύϝϛϋϊᾄᾆᾳᾴᾷαβγδεζηθικλμνξοπρστυφχψωἀἄἂἆἁἅἃἇάὰᾶἐἔἒἑἕἓὲέἠἤἢἦἡἥἣἧὴήᾐᾑᾒᾓᾔᾕᾖᾗῂῃῄῆῇἰἴἲἶἱἵἳἷὶίῐῑῒΐῖῗὀὄὂὁὅὃὸόὐὑὒὓὔὕὖὗὺῦύῠῡῢΰῧὠὤὢὦὡὥὣὧώὼᾠᾡᾢᾣᾤᾥᾦᾧῲῳῴῶῷῤῥἈἌἊἎἉἍἋἏᾺΆᾼᾈᾉᾊᾋᾌᾍᾎᾏἘἜἚἙἝἛῈΈἨἬἪἮἩἭἫἯῊΉῌᾘᾙᾚᾛᾜᾝᾞᾟἸἼἺἾἹἽἻἿΊῚῘῙὈὌὊὉὍὋΌῸὙὝὛὟΎῪῨῩὨὬὪὮὩὭὫὯΏῺῼᾨᾩᾪᾫᾬᾭᾮᾯῬς]/
NON_DEF_TEXT: "~|" /[^|]*/ "|~"
NOTE: "/*" /(.|\n)*?/ "*/"
NAME: /[a-zA-Z]+/
RESP: /=[ \-.:,()a-zA-Z0-9]+/
RESP_NO_COLON: /=[ \-.,()a-zA-Z0-9]+/
NAME_HYPHEN: /[a-zA-Z\-]+/
NAME_OR_NUMBER: /[a-zA-Z0-9+]+/
FRACTION: /[0-9]+\/[0-9]+/
SPACE: " "
NEWLINE: "\n"

// SPECIAL CHARACTERS
TICK: "'"
UNDERDOT: "\u0323"
SUPRALINEAR: "\u0304"
CERTAINTY_MATCH: "(?)"
EXTENT_UNKNOWN: "?"
CERT_LOW: "?" | "(?)"
SLAHES: "/"
CROSS_STROKES: "X"
LANG: "grc" | "ar" | "cop" | "egy-Egyd" | "la" | "grc-Latn" | "la-Grek"
APP_MODE: "reg" | "alt" | "subst" | "corr" | "ed"
REND: "extension" | "diple"
SUPRA_ALPHA_SMALL: "ᾱ"
SUPRA_ALPHA_CAPITAL: "Ᾱ"
SUPRA_IOTA_SMALL: "ῑ"
SUPRA_IOTA_CAPITAL: "Ῑ"
SUPRA_YPSILON_SMALL: "ῡ"
SUPRA_YPSILON_CAPITAL: "Ῡ"
?supra_escape: SUPRA_ALPHA_SMALL | SUPRA_ALPHA_CAPITAL | SUPRA_IOTA_SMALL | SUPRA_IOTA_CAPITAL | SUPRA_YPSILON_SMALL | SUPRA_YPSILON_CAPITAL

// START-END
NUM_START: "<#"
NUM_END: "#>"
OMITTED_START: "<"
OMITTED_END: ">"
APP_START: "<:"
APP_END: ":>"
LINES_UNTRANSCRIBED_START: "(Lines:"
CHARS_UNTRANSCRIBED_START: "(Chars:"
NON_TRANSCRIBED: "non transcribed"

// DIACRITICALS
DIARESIS: "¨" | "&D"
ASPER: " ῾" | "&AS"
ACUTE: "´" | "&AC"
CIRCUMFLEX: "^" | "&C"
LENIS: " ᾿" | "&L"
GRAVE: "`" | "&G"

?item: line
    | line_formatted
    | line_margin
    | line_rend
    | vacat
    | add_above
    | add_below
    | add_left
    | add_right
    | add_interlin
    | add_sling
    | add_underline
    | box
    | tall
    | superscripted
    | subscripted
    | supraline
    | supraline_underline
    | supralinear_stroke
    | lines_lost
    | illegible
    | vestiges
    | ancient_number
    | omitted
    | surplus
    | deletion
    | abbreviation
    | gap_lost
    | supplied_lost
    | parallel
    | parallel_lost
    | unclear
    | default_language
    | non_default_language
    | omitted_language
    | ex
    | expansion
    | apparatus
    | symbol
    | drawing
    | apparatus_multiple_front
    | apparatus_multiple_back
    | handshift
    | note
    | quotation
    | diacritical_element
    | paragraphos
    | horizontal_rule
    | wavy_line
    | diple_obelismene
    | coronis
    | text_full_stop
    | text_space
    | text
    | lines_untranscribed
    | characters_untranscribed

?ex_or_text: ex | text | CERT_LOW

?number_content: supralinear_stroke | TEXT | TICK | SPACE | unclear | illegible | "[" text [CERT_LOW] "]" | "[." QUANTITY  "]"

// PRESERVATION (VACAT, VESTIGES
vacat: "vac." [CIRCA] (range | QUANTITY | EXTENT_UNKNOWN) [LIN]
lines_lost: "lost." [CIRCA] (range | QUANTITY | EXTENT_UNKNOWN) LIN [CERTAINTY_MATCH]
illegible: (CIRCA | DOT) (range | QUANTITY | EXTENT_UNKNOWN) [LIN]
vestiges: "vestig" [DOT] [CIRCA] (range | QUANTITY | EXTENT_UNKNOWN)? (LIN | CHAR)?

// LINE
line: NEWLINE NUMBER "." [LB] SPACE
line_margin: "\n" NUMBER LIN_MARGIN "." [LB] " "
line_rend: "\n(" NUMBER ["." LB] ", " LIN_FORMAT ") "
line_formatted: "\n(" NUMBER LIN_MARGIN ["." LB] ", " LIN_FORMAT ") "

// ADD
add_above: "\\" item+ [CERT_LOW] "/"
add_below: "//" item+ [CERT_LOW] "\\\\"
add_left: "||left:" item+ [CERT_LOW] "||"
add_right: "||right:" item+ [CERT_LOW] "||"
add_interlin: "||interlin:" item+ [CERT_LOW] "||"
add_sling: "<|" item+ [CERT_LOW] "|>"
add_underline: "<_" item+ [CERT_LOW] "_>"

// SPECIAL TEXT FORMAT
tall: "~||" item+ "||~tall"
superscripted: "|^" item+ "^|"
subscripted: "\\|" item+ "|/"
supralinear_stroke: (GREEK_CHAR SUPRALINEAR | supra_escape)+
supraline: "¯" item+ "¯"
supraline_underline: "¯_" item+ "_¯"

// NUMBERS, SYMBOLS AND SPECIAL CHARACTERS
ancient_number: NUM_START (number_content)* "=" [NUMBER | FRACTION] NUM_END
symbol: "*" NAME_HYPHEN ("(" REND ")")? [CERT_LOW] "*"
drawing: "#" NAME_HYPHEN SPACE
box: "###"
paragraphos: NEWLINE "----"
horizontal_rule: NEWLINE "--------"
wavy_line: NEWLINE "~~~~~~~~"
diple_obelismene: NEWLINE ">---"
coronis: NEWLINE "-$$-"

// LEIDEN CONVENTIONS
omitted: OMITTED_START item+ [CERT_LOW] OMITTED_END
surplus: "{" item+ "}"
deletion: "〚" (SLAHES | CROSS_STROKES)? item+ "〛"
abbreviation: "(|" item+ [CERTAINTY_MATCH] "|)"
supplied_lost: "[" item+ [CERT_LOW] "]"
gap_lost: "[" (CIRCA | DOT) (range | QUANTITY | EXTENT_UNKNOWN) "]" (OR gap_lost)*
parallel: "|_" item+ [CERT_LOW] "_|"
parallel_lost: "_[" item+ "]_"
unclear: GREEK_CHAR UNDERDOT
handshift: "$" NAME_OR_NUMBER [CERT_LOW]
note: NOTE
quotation: /"/ item+ /"/
diacritical: DIARESIS | ASPER | ACUTE | CIRCUMFLEX | LENIS | GRAVE
diacritical_element: SPACE (GREEK_CHAR | supplied_lost | gap_lost | illegible) "(" diacritical+ ")"
ex: "(" item+ [CERT_LOW] ")"
expansion: "(" ex_or_text+ ")"

// APPARATUS: must be improved for the transformer; careful: sometimes CERT_LOW, ocasionally CERTAINTY_MATCH
apparatus: APP_START item+ [CERT_LOW] [RESP]"|" APP_MODE "|" (item+ [CERT_LOW] [RESP_NO_COLON])? APP_END
apparatus_multiple_back: APP_START item+ [CERT_LOW] [RESP] "||" APP_MODE "||" item+ ("|" item+ [CERT_LOW] [RESP_NO_COLON])+ APP_END
apparatus_multiple_front: APP_START item+ [CERT_LOW] [RESP] ("|" item+ [CERT_LOW] [RESP])+ "||" APP_MODE "||" item+ [CERT_LOW] [RESP_NO_COLON] APP_END

// LANGUAGE
non_default_language: NON_DEF_TEXT LANG
omitted_language: "(Lang:" SPACE NAME SPACE [CIRCA] (QUANTITY | range | EXTENT_UNKNOWN) SPACE (LIN | CHAR) ")"

// UNTRANSCRIBED
lines_untranscribed: LINES_UNTRANSCRIBED_START SPACE [CIRCA] (QUANTITY | range | EXTENT_UNKNOWN) SPACE NON_TRANSCRIBED ")"
characters_untranscribed: CHARS_UNTRANSCRIBED_START SPACE [CIRCA] (QUANTITY | range | EXTENT_UNKNOWN) SPACE NON_TRANSCRIBED ")"

// TEXT
text_full_stop: DOT
text_space: SPACE
text: TEXT