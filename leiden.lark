?start: file_start
file_start: default_language (superdiv | div)+
superdiv: div_start (superdiv | div)+ DIV_CLOSE
div: div_start TEXTBLOCK_OPEN item+ TEXTBLOCK_CLOSE DIV_CLOSE
div_start: DIV_OPEN "." (NAME_OR_NUMBER | RECTO | VERSO) ["." SUBTYPE]

// TEXT DIVISON
DIV_OPEN: "<D="
DIV_CLOSE: "=D>"
TEXTBLOCK_OPEN: "<="
TEXTBLOCK_CLOSE: "=>"
RECTO: "r"
VERSO: "v"
SUBTYPE: "fragment" | "part" | "column" | "folio" | "side"

// QUANTIFIERS AND UNITS
CIRCA: "ca."
NUMBER: /[0-9]+/
RANGE: /[0-9]+-[0-9]+/
LIN: "lin" | "lines"
UNIT: LIN | "char"
LIN_FORMAT: "perpendicular" | "inverse" | "indent" | "outdent"
LIN_MARGIN: "ms" | "md" | "msup" | "minf"
DOT: "."
LB: "-"

// TEXT
TEXT: /[ ;,·˙\u0300-\u036Fα-ωΑ-ΩΌΏΎΊΉᾲᾀᾁᾂᾃᾅᾇέάΐήώίόύϝϛϋϊᾄᾆᾳᾴᾷαβγδεζηθικλμνξοπρστυφχψωἀἄἂἆἁἅἃἇάὰᾶἐἔἒἑἕἓὲέἠἤἢἦἡἥἣἧὴήᾐᾑᾒᾓᾔᾕᾖᾗῂῃῄῆῇἰἴἲἶἱἵἳἷὶίῐῑῒΐῖῗὀὄὂὁὅὃὸόὐὑὒὓὔὕὖὗὺῦύῠῡῢΰῧὠὤὢὦὡὥὣὧώὼᾠᾡᾢᾣᾤᾥᾦᾧῲῳῴῶῷῤῥἈἌἊἎἉἍἋἏᾺΆᾼᾈᾉᾊᾋᾌᾍᾎᾏἘἜἚἙἝἛῈΈἨἬἪἮἩἭἫἯῊΉῌᾘᾙᾚᾛᾜᾝᾞᾟἸἼἺἾἹἽἻἿΊῚῘῙὈὌὊὉὍὋΌῸὙὝὛὟΎῪῨῩὨὬὪὮὩὭὫὯΏῺῼᾨᾩᾪᾫᾬᾭᾮᾯῬς]+/
TEXT_CHAR: /[α-ωΑ-ΩΌΏΎΊΉᾲᾀᾁᾂᾃᾅᾇέάΐήώίόύϝϛϋϊᾄᾆᾳᾴᾷαβγδεζηθικλμνξοπρστυφχψωἀἄἂἆἁἅἃἇάὰᾶἐἔἒἑἕἓὲέἠἤἢἦἡἥἣἧὴήᾐᾑᾒᾓᾔᾕᾖᾗῂῃῄῆῇἰἴἲἶἱἵἳἷὶίῐῑῒΐῖῗὀὄὂὁὅὃὸόὐὑὒὓὔὕὖὗὺῦύῠῡῢΰῧὠὤὢὦὡὥὣὧώὼᾠᾡᾢᾣᾤᾥᾦᾧῲῳῴῶῷῤῥἈἌἊἎἉἍἋἏᾺΆᾼᾈᾉᾊᾋᾌᾍᾎᾏἘἜἚἙἝἛῈΈἨἬἪἮἩἭἫἯῊΉῌᾘᾙᾚᾛᾜᾝᾞᾟἸἼἺἾἹἽἻἿΊῚῘῙὈὌὊὉὍὋΌῸὙὝὛὟΎῪῨῩὨὬὪὮὩὭὫὯΏῺῼᾨᾩᾪᾫᾬᾭᾮᾯῬς]/
NON_DEF_TEXT: "~|" /.*?/ "|~"
NOTE: "/*" /(.|\n)*?/ "*/"
NAME: /[a-zA-Z]+/
NAME_HYPHEN: /[a-zA-Z\-]+/
NAME_OR_NUMBER: /[a-zA-Z0-9+]+/
FRACTION: /[0-9]+\/[0-9]+/

// SPECIAL CHARACTERS
TICK: "'"
UNDERDOT_CHAR: TEXT_CHAR "\u0323"
SUPRALINE_CHAR: TEXT_CHAR "\u0304"
UNCERTAIN: "(\\?)" | "\\?"
LANG: "grc" | "ar" | "cop" | "egy-Egyd" | "la" | "grc-Latn" | "la-Grek"
APP_MODE: "reg" | "alt" | "subst" | "corr"
LOST_1: "[.1]"
ILLEGIBLE_1: ".1"
REND: "extension" | "diple"

// DIACRITICALS
DIARESIS: "¨"
ASPER: "῾"
ACUTE: "´"
CIRCUMFLEX: "^"
LENIS: "᾿"
GRAVE: "`"
DIACRITICAL: DIARESIS | ASPER | ACUTE | CIRCUMFLEX | LENIS | GRAVE

?item: line
    | line_formatted
    | line_margin
    | vacat
    | add_above
    | add_below
    | add_left
    | add_right
    | add_interlin
    | add_sling
    | add_underline
    | box
    | tall
    | superscripted
    | subscripted
    | supraline
    | supraline_underline
    | supralinear_stroke
    | lines_lost
    | illegible
    | vestiges
    | omitted
    | surplus
    | deletion
    | abbreviation
    | characters_supplied
    | characters_lost
    | parallel
    | text
    | unclear
    | default_language
    | non_default_language
    | omitted_language
    | ex
    | expansion
    | apparatus
    | symbol
    | ancient_number
    | drawing
    | editorial_correction
    | editorial_correction_multiple
    | apparatus_multiple
    | handshift
    | note
    | quotation
    | diacriticals

?nested: illegible
    | text
    | omitted
    | surplus
    | deletion
    | abbreviation
    | expansion
    | ex
    | unclear
    | characters_lost
    | characters_supplied

?text_or_unclear: text | unclear

?ex_or_text: ex | text

// PRESERVATION (VACAT, VESTIGES
vacat: "vac." [CIRCA] (RANGE | NUMBER | UNCERTAIN) [UNIT]
lines_lost: "lost." [CIRCA] (RANGE | NUMBER | UNCERTAIN) "lin"
illegible: "." [CIRCA] (RANGE | NUMBER | UNCERTAIN) [LIN]
vestiges: "vestig" [DOT] [CIRCA] [(RANGE | NUMBER | UNCERTAIN)] [LIN]

// LINE
line: NUMBER "." [LB]
line_margin: NUMBER "," LIN_MARGIN
line_formatted.3: "(" (NUMBER (DOT LB)? | line_margin) "," LIN_FORMAT ")"

// ADD
add_above: "\\" nested+ "/"
add_below: "//" nested+ "\\"
add_left: "||left:" nested+ "||"
add_right: "||right:" nested+ "||"
add_interlin: "||interlin:" nested+ "||"
add_sling: "<|" nested+ "|>"
add_underline: "<_" nested+ "_>"

// SPECIAL TEXT FORMAT
tall: "~||" text_or_unclear+ "||~tall"
superscripted: "|^" text_or_unclear+ "^|"
subscripted: "\\|" text_or_unclear+ "|/"
supralinear_stroke: SUPRALINE_CHAR+
supraline: "¯" text_or_unclear+ "¯"
supraline_underline: "¯_" text_or_unclear+ "_¯"

// LEIDEN CONVENTIONS
omitted: "<" text_or_unclear+ [UNCERTAIN] ">"
surplus: "{" text_or_unclear+ "}"
deletion: "〚" text_or_unclear+ "〛"
abbreviation: "(|" item+ [UNCERTAIN] "|)"
characters_supplied: "[" item+ [UNCERTAIN] "]"
characters_lost: "[" (CIRCA | DOT) (RANGE | NUMBER | UNCERTAIN) "]"
parallel: "|_" item+ "_|"
unclear: UNDERDOT_CHAR+
handshift: "$" NAME_OR_NUMBER [UNCERTAIN]
note: NOTE
quotation: "\"" text+ "\""
diacriticals.3: TEXT_CHAR "(" DIACRITICAL+ ")" | ILLEGIBLE_1 "(" DIACRITICAL ")" | LOST_1 "(" DIACRITICAL ")"
ex.1: "(" text ")"
expansion.2: "(" ex_or_text+ ")"

// APPARATUS
apparatus: "<:" nested+ "|" APP_MODE "|" nested+ ":>"
apparatus_multiple: "<:" nested+ "||" APP_MODE "||" nested+ ("|" nested+)+ ":>"
editorial_correction: "<:" nested+ "|ed|" nested+ ["=" NAME] ":>"
editorial_correction_multiple: "<:" nested+ "||ed||" nested+ ["=" NAME] ("|" nested+ ["=" NAME])+ ":>"

// NUMBERS, SYMBOLS AND SPECIAL CHARACTERS
ancient_number: "<#" (text | TICK | illegible | characters_lost | supralinear_stroke | supraline)+ "=" (NUMBER | FRACTION) "#>"
symbol: "*" NAME_HYPHEN ("(" REND ")")? "*"
drawing: "#" NAME_HYPHEN
box: "###"
paragraphos: "----"
horizontal_rule: "--------"
wavy_line: "~~~~~~~~"
diple_obelismene: ">---"
coronis: "-$$-"

// LANGUAGE
default_language: "<S=." LANG
non_default_language: NON_DEF_TEXT LANG
omitted_language: "(Lang: "NAME [CIRCA] (NUMBER | RANGE | UNCERTAIN) UNIT ")"

// UNTRANSCRIBED
lines_untranscribed: "(Lines:" [CIRCA] (NUMBER | RANGE | UNCERTAIN) " non transcribed)"
characters_untranscribed: "(Chars:" [CIRCA] (NUMBER | RANGE | UNCERTAIN) " non transcribed)"

// TEXT
text: TEXT

%import common.WS
%ignore WS